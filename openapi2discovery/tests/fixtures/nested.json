{
  "openapi": "3.0.3",
  "info": {
    "title": "Blog API",
    "version": "v2",
    "description": "A blog with nested resources"
  },
  "servers": [{ "url": "https://blog.example.com/api" }],
  "paths": {
    "/users": {
      "get": {
        "summary": "List users",
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/users/{userId}": {
      "get": {
        "summary": "Get user",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/users/{userId}/posts": {
      "get": {
        "summary": "List posts for user",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "post": {
        "summary": "Create post",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Post" }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/users/{userId}/posts/{postId}": {
      "get": {
        "summary": "Get post",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "put": {
        "summary": "Update post",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Post" }
            }
          }
        },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/users/{userId}/posts/{postId}/comments": {
      "get": {
        "summary": "List comments on post",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/users/{userId}/posts/{postId}/comments/{commentId}": {
      "get": {
        "summary": "Get comment",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "delete": {
        "summary": "Delete comment",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "deleted" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Post": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "author": { "$ref": "#/components/schemas/User" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
